Save this file as `main.py` in the project root.

```python
#!/usr/bin/env python3
"""
Airbnb Cradle Mountain Scraper — Entry Point

Usage:
    python main.py

Output:
    results.json — structured listing data

Requirements:
    pip install playwright
    python -m playwright install chromium
"""

import asyncio
import json
import logging
import sys
from datetime import datetime

import config
from scraper import AirbnbScraper

# --- Logging Setup ---
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
    datefmt="%H:%M:%S",
)
logger = logging.getLogger("airbnb-scraper")


async def main():
    """Run the scraper and save results."""
    logger.info("=" * 60)
    logger.info("Airbnb Cradle Mountain Scraper")
    logger.info(f"Search: {config.LOCATION}")
    logger.info(f"Dates: {config.CHECKIN_DATE} → {config.CHECKOUT_DATE}")
    logger.info(f"Guests: {config.ADULTS}")
    logger.info(f"Target: {config.MIN_LISTINGS}-{config.TARGET_LISTINGS} listings")
    logger.info("=" * 60)

    scraper = AirbnbScraper()

    try:
        result = await scraper.run()
    except KeyboardInterrupt:
        logger.info("Scraping interrupted by user.")
        sys.exit(1)
    except Exception as e:
        logger.error(f"Fatal error: {e}")
        sys.exit(2)

    # Save results
    output_path = config.OUTPUT_FILE
    result.save(output_path)

    # Print summary
    print("\n" + "=" * 60)
    print("SCRAPING COMPLETE")
    print("=" * 60)
    print(f"Listings found: {result.total_listings_found}")
    print(f"Pages scraped: {result.pages_scraped}")
    print(f"Aurora viewing: {len(result.aurora_properties)} properties")
    print(f"Stargazing:     {len(result.stargazing_properties)} properties")
    print(f"Errors:         {len(result.errors)}")

    if result.aurora_properties:
        print("\n🌌 AURORA VIEWING PROPERTIES:")
        for name in result.aurora_properties:
            print(f"   • {name}")

    if result.stargazing_properties:
        print("\n⭐ STARGAZING PROPERTIES:")
        for name in result.stargazing_properties:
            print(f"   • {name}")

    if result.errors:
        print("\n⚠️  ERRORS:")
        for err in result.errors:
            print(f"   • {err}")

    # Print listing summary table
    if result.listings:
        print(f"\n{'─' * 60}")
        print(f"{'#':<3} {'Name':<35} {'Price/Night':<15} {'Rating':<6}")
        print(f"{'─' * 60}")
        for i, listing in enumerate(result.listings, 1):
            name = listing.name[:33] + ".." if len(listing.name) > 35 else listing.name
            print(f"{i:<3} {name:<35} {listing.price_per_night:<15} {listing.rating:<6}")

    print(f"\nFull results saved to: {output_path}")
    print(f"Timestamp: {datetime.now().isoformat()}")

    return result


if __name__ == "__main__":
    asyncio.run(main())
