# Setup & Run Script — setup.sh

Save as `setup.sh` and run with `bash setup.sh`.

```bash
#!/bin/bash
set -e

echo "=== Airbnb Cradle Mountain Scraper Setup ==="
echo ""

# Check Python version
echo "[1/4] Checking Python version..."
python3 --version || { echo "ERROR: Python 3.8+ required"; exit 1; }

# Create virtual environment
echo "[2/4] Creating virtual environment..."
python3 -m venv .venv
source .venv/bin/activate

# Install dependencies
echo "[3/4] Installing dependencies..."
pip install --upgrade pip
pip install playwright>=1.40.0

# Install browser
echo "[4/4] Installing Chromium browser for Playwright..."
python -m playwright install chromium

echo ""
echo "=== Setup Complete ==="
echo ""
echo "To run the scraper:"
echo "  source .venv/bin/activate"
echo "  python main.py"
echo ""
echo "Note: The scraper opens a visible browser window by default."
echo "      Airbnb blocks headless browsers aggressively."
echo "      Set HEADLESS=True in config.py only for debugging."
```
